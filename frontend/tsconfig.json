{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      // vuex 4 does not expose its types through package.json "exports"
      "vuex": ["./node_modules/vuex/types/index.d.ts"]
    },
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "vite.config.ts"]
}
